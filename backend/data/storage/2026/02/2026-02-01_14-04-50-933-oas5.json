    {
      "id": "msg_fe5fb24e056f",
      "parent_id": null,
      "role": "user",
      "content": "介绍一下 redis",
      "type": "text",
      "created_at": 1769926026,
      "children_ids": [
        "msg_249297926c43"
      ],
      "model_info": null,
      "usage": null,
      "status": null,
